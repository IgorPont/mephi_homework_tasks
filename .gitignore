!sessions_tasks/classical_ml/session02/sber_auto_subscription/models/.gitkeep

# Результаты запусков
sessions_tasks/classical_ml/session02/sber_auto_subscription/outputs/*
!sessions_tasks/classical_ml/session02/sber_auto_subscription/outputs/.gitkeep
!sessions_tasks/classical_ml/session02/sber_auto_subscription/outputs/figures/

