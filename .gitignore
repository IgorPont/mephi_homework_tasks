!sessions_tasks/classical_ml/session02/sber_auto_subscription/data/raw/.gitkeep

# Подготовленные датасеты
sessions_tasks/classical_ml/session02/sber_auto_subscription/data/processed/*
!sessions_tasks/classical_ml/session02/sber_auto_subscription/data/processed/.gitkeep

# Обученные модели
